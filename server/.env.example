# SQLite for local development. For production switch the datasource
# provider in prisma/schema.prisma to "postgresql" and point this at your DB.
DATABASE_URL="file:./dev.db"
# Long random string used to sign session cookies: openssl rand -base64 32
AUTH_SECRET="change-me"

# --- Verification codes -------------------------------------------------
# Without these, codes are only printed to the server log and returned to the
# app in development. In production the server refuses to send codes until
# the channel being used is configured.

# Email, through Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="My Ummah <verify@example.com>"

# WhatsApp, through the Meta WhatsApp Cloud API. The template must be an
# approved "authentication" template with a copy-code button.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="verification_code"
WHATSAPP_TEMPLATE_LANG="en"
WHATSAPP_API_VERSION="v22.0"
